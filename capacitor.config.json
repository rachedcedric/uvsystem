{
  "appId": "ci.uvmaster.app",
  "appName": "UVMASTER",
  "webDir": "capacitor-www",
  "appendUserAgent": "UvmasterApp",
  "server": {
    "url": "https://uvmaster.ci/m",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#F5F7F2",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
