# UVMASTER — modèle de configuration de production. COPIER vers deploy/.env.production (jamais commité) et remplir.
# Aucune valeur secrète n'est écrite ici : générer chaque secret avec `openssl rand -base64 32`.

# --- Identité et domaine ---------------------------------------------------------------------------------
APP_NAME="UVMASTER CI"           # VALEUR TECHNIQUE aussi (dossier de sauvegardes storage/app/UVMASTER CI/, cookie de session, cache) : ne plus la modifier une fois en production
APP_ENV=production
APP_DEBUG=false
APP_URL=https://uvmaster.ci
APP_DOMAIN=uvmaster.ci
ACME_EMAIL=                      # adresse pour Let's Encrypt (alertes d'expiration)
BRAND_NAME=UVMASTER
BRAND_TAGLINE="La gestion des UV simplifiée"
BRAND_URL=https://uvmaster.ci
BRAND_DOMAIN=uvmaster.ci
BRAND_CONTACT_EMAIL=contact@uvmaster.ci
APP_KEY=                         # php artisan key:generate --show  (CONSERVER la clé de production actuelle si les données sont migrées : elle chiffre des données)
APP_LOCALE=fr
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Coordonnées affichées dans les documents (anciennes valeurs COMPANY_* à METTRE À JOUR) -----------------
COMPANY_NAME="UVMASTER"
COMPANY_TAGLINE="La gestion des UV simplifiée"
COMPANY_EMAIL=contact@uvmaster.ci
COMPANY_WEBSITE=uvmaster.ci
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_PHONE=

# --- Base de données (service « db » du compose) ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=uvmaster
DB_USERNAME=uvmaster
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DUMP_SKIP_SSL=true            # conteneur MySQL sur réseau privé Docker (certificat auto-signé)
MYSQL_IMAGE=mysql:8.0            # METTRE LA VERSION EXACTE de la base source (voir docs/MIGRATION-UVMASTER.md)

# --- Sessions, cache, files (base de données ; pas de Redis dans cette pile) -------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
SANCTUM_STATEFUL_DOMAINS=uvmaster.ci
CORS_ALLOWED_ORIGINS=https://uvmaster.ci

# --- E-mail (Resend) : le domaine uvmaster.ci doit être vérifié chez le fournisseur (SPF/DKIM) --------------
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=contact@uvmaster.ci
MAIL_FROM_NAME="UVMASTER CI"
RESEND_KEY=
RESEND_WEBHOOK_SECRET=
BACKUP_NOTIFICATION_EMAIL=admin@uvmaster.ci
SECURITY_NOTIFICATION_EMAILS=contact@uvmaster.ci

# --- SMS (Twilio) : l'identifiant d'expéditeur ne change qu'après accord de l'opérateur ---------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Notifications push (Firebase) : le projet et l'identifiant d'application Android ne changent pas ------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=            # chemin DANS le conteneur du fichier de compte de service (monté en lecture seule, jamais commité)

# --- Sécurité -----------------------------------------------------------------------------------------------
SECURITY_2FA_ENABLED=true
SECURITY_2FA_ENFORCE_FROM=2026-11-01
SUBSCRIPTION_REQUIRED=true
BACKUP_ARCHIVE_PASSWORD=
